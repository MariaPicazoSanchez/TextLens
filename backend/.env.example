GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed frontend origins.
# Use * to allow all origins (dev only). In production set the real domain, e.g.:
# ALLOWED_ORIGINS=https://textlens.app,https://www.textlens.app
ALLOWED_ORIGINS=*

# Comma-separated IPs of trusted reverse proxies (nginx, Cloudflare, load balancer).
# When set, the real client IP is read from X-Forwarded-For instead of the socket.
# Leave empty when running without a proxy (direct exposure or local dev).
# TRUSTED_PROXIES=127.0.0.1

# Minimum level for the JSON application logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Environment name attached to logs and Sentry events.
ENVIRONMENT=development

# Optional. Enables error tracking via Sentry (https://sentry.io — free tier
# available). Create a project there, copy its DSN here, and errors will start
# showing up automatically. Leave unset to run with Sentry fully disabled.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0